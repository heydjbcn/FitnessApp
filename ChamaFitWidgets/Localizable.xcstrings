          "stringUnit": {
            "state": "translated",
            "value": "Apunta la següent sèrie de l'entrenament d'avui amb el pes i les repeticions que diguis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log the next set of today's workout with the weight and reps you say."
          }
        }
      }
    },
