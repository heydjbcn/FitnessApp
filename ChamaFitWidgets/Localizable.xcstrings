    "Guarda tu peso de hoy en ChamaFit (y en Salud si le has dado permiso).": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa el teu pes d'avui a ChamaFit (i a Salut si li has donat permís)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves today's weight in ChamaFit (and in Health if you've granted permission)."
