        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It changes on every day where you have it."
          }
        }
      }
    },
    "Se crea como rutina nueva; la de ahora queda guardada en Calendario › Rutinas.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es crea com a rutina nova; la d'ara queda desada a Calendari › Rutines."
