import SwiftUI
import Combine
import Foundation
import AudioToolbox
import UIKit
import CoreData

@MainActor
class WorkoutViewModel: ObservableObject {
    
    // MARK: - Published Properties
    @Published var activeDays: [WorkoutDay] = []
    @Published var availableExercises: [Exercise] = []
    @Published var dailyWorkoutRecords: [WorkoutDay: [WorkoutExercise]] = [:]
    @Published var workoutHistory: [Date: [WorkoutDay: [WorkoutExercise]]] = [:]
    @Published var bodyWeightHistory: [Date: Double] = [:]
    @Published var sessionNotes: [Date: String] = [:]
    
    // Timer State
    @Published var timerActive = false
    @Published var timeRemaining = 120
    @Published var currentTimerDuration: Int = 120
    @Published var isTimerEnabled = true
    @Published var selectedTimerExercise: Exercise?
    @Published var restDuration: Int = 120
    
    // Managers and Services
    @Published var onboardingManager = OnboardingManager()
    
    // 🔧 NUEVO: Core Data Integration Optimizado
    @Published var isCoreDataActive: Bool = false
    private let coreDataManager = CoreDataManager.shared
    internal var workoutService: WorkoutService? { WorkoutService.shared }
    internal var migrationManager: DataMigrationManager { DataMigrationManager.shared }
    
    // 🚀 NUEVO: Queue para operaciones de guardado
    private let saveQueue = DispatchQueue(label: "workout.save.queue", qos: .utility)
    private var saveWorkItem: DispatchWorkItem?
    
    // 🔧 NUEVO: Cache para mejorar rendimiento
    private var exerciseCache: [UUID: Exercise] = [:]
    private var lastSaveTime: Date = Date()
    private let minimumSaveInterval: TimeInterval = 2.0 // Mínimo 2 segundos entre guardados
    
    // Internal Properties
    private var timer: Timer?
    private var timerWorkItem: DispatchWorkItem?
    private var isUpdatingRestDuration = false
    private var isSaving = false
    private let MAX_HISTORY_DAYS = 90
    
    // MARK: - Initialization
    init() {
        setupInitialData()
        loadData()
        
        // 🚀 NUEVO: Observer para Core Data
        Task {
            await observeCoreDataChanges()
        }
    }
    
    // MARK: - 🔧 OPTIMIZED SAVE SYSTEM
    
    /// Sistema de guardado optimizado - NO bloquea UI
    private func saveData() {
        // 🚀 Cancelar guardado anterior si existe
        saveWorkItem?.cancel()
        
        // 🔧 Throttling - evitar guardados excesivos
        let now = Date()
        let timeSinceLastSave = now.timeIntervalSince(lastSaveTime)
        
        let delay: TimeInterval = timeSinceLastSave < minimumSaveInterval ? 
                                  (minimumSaveInterval - timeSinceLastSave) : 0
        
        // 🚀 Crear nueva work item
        saveWorkItem = DispatchWorkItem { [weak self] in
            self?.performOptimizedSave()
        }
        
        // Ejecutar después del delay
        saveQueue.asyncAfter(deadline: .now() + delay, execute: saveWorkItem!)
    }
    
    /// Guardado real optimizado
    private func performOptimizedSave() {
        guard !Thread.isMainThread else {
            // Si estamos en main thread, mover a background
            saveQueue.async { [weak self] in
                self?.performOptimizedSave()
            }
            return
        }
        
        guard !isSaving else { return }
        isSaving = true
        defer { isSaving = false }
        
        lastSaveTime = Date()
        
        // 🔧 Guardar en UserDefaults de forma optimizada
        let encoder = JSONEncoder()
        
        do {
            // Batch encode para mejor rendimiento
            let exercisesData = try encoder.encode(availableExercises)
            let recordsData = try encoder.encode(dailyWorkoutRecords)
            let historyData = try encoder.encode(workoutHistory)
            let bodyWeightData = try encoder.encode(bodyWeightHistory)
            let notesData = try encoder.encode(sessionNotes)
            let activeDaysData = try encoder.encode(activeDays)
            
            // Escribir todo de una vez
            UserDefaults.standard.set(exercisesData, forKey: "AvailableExercises")
            UserDefaults.standard.set(recordsData, forKey: "DailyWorkoutRecords")
            UserDefaults.standard.set(historyData, forKey: "WorkoutHistory")
            UserDefaults.standard.set(bodyWeightData, forKey: "BodyWeightHistory")
            UserDefaults.standard.set(notesData, forKey: "SessionNotes")
            UserDefaults.standard.set(activeDaysData, forKey: "ActiveDays")
            
            print("✅ Data saved successfully")
            
        } catch {
            print("❌ Failed to save data: \(error)")
        }
    }
    
    // MARK: - 🚀 OPTIMIZED OPERATIONS
    
    func addExercise(_ newBaseExercise: Exercise, to selectedDays: Set<WorkoutDay>) {
        // 🔧 Optimización: Operación batch
        availableExercises.append(newBaseExercise)
        exerciseCache[newBaseExercise.id] = newBaseExercise
        
        for day in selectedDays {
            let newWorkoutRecord = WorkoutExercise(from: newBaseExercise)
            dailyWorkoutRecords[day]?.append(newWorkoutRecord)
        }
        
        HapticManager.shared.exerciseAdded()
        saveData() // Guardado optimizado
    }
    
    func removeExercise(recordId: UUID, from day: WorkoutDay) {
        dailyWorkoutRecords[day]?.removeAll { $0.id == recordId }
        recordHistory(for: day)
        saveData()
    }
    
    func removeExercise(baseExercise: Exercise) {
        // 🔧 Optimización: Batch operations
        availableExercises.removeAll { $0.id == baseExercise.id }
        exerciseCache.removeValue(forKey: baseExercise.id)
        
        for day in WorkoutDay.allCases {
            dailyWorkoutRecords[day]?.removeAll { $0.exerciseId == baseExercise.id }
        }
        
        HapticManager.shared.exerciseDeleted()
        saveData()
    }
    
    func completeSet(for exerciseId: UUID, in day: WorkoutDay, weight: Double, reps: Int) {
        guard let recordIndex = dailyWorkoutRecords[day]?.firstIndex(where: { $0.exerciseId == exerciseId }) else { return }
        
        var record = dailyWorkoutRecords[day]![recordIndex]
        
        // 🔧 Optimización: Operación directa sin múltiples accesos
        record.completedSets += 1
        record.lastSetCompletedAt = Date()
        record.maxWeight = max(record.maxWeight, weight)
        record.totalVolume += weight * Double(reps)
        
        dailyWorkoutRecords[day]![recordIndex] = record
        
        // 🚀 NUEVO: Rest timer automático
        if let exercise = getExercise(by: exerciseId) {
            startRestTimer(for: exercise)
        }
        
        recordHistory(for: day)
        HapticManager.shared.success()
        saveData()
    }
    
    func undoSet(for exerciseId: UUID, in day: WorkoutDay, weight: Double, reps: Int) {
        guard let recordIndex = dailyWorkoutRecords[day]?.firstIndex(where: { $0.exerciseId == exerciseId }) else { return }
        
        var record = dailyWorkoutRecords[day]![recordIndex]
        
        if record.completedSets > 0 {
            record.completedSets -= 1
            if record.completedSets == 0 { 
                record.lastSetCompletedAt = nil 
            }
            record.totalVolume = max(0, record.totalVolume - weight * Double(reps))
            
            dailyWorkoutRecords[day]![recordIndex] = record
            recordHistory(for: day)
            HapticManager.shared.warning()
            saveData()
        }
    }
    
    // MARK: - 🚀 TIMER OPTIMIZATIONS
    
    private func startRestTimer(for exercise: Exercise) {
        guard isTimerEnabled else { return }
        
        // Cancelar timer anterior
        timer?.invalidate()
        timerWorkItem?.cancel()
        
        selectedTimerExercise = exercise
        currentTimerDuration = exercise.restDuration
        timeRemaining = exercise.restDuration
        timerActive = true
        
        // 🔧 Timer en background queue
        timer = Timer.scheduledTimer(withTimeInterval: 1.0, repeats: true) { [weak self] timer in
            guard let self = self, self.timerActive else {
                timer.invalidate()
                return
            }
            
            Task { @MainActor in
                self.timeRemaining -= 1
                
                if self.timeRemaining <= 0 {
                    self.timerActive = false
                    self.timer?.invalidate()
                    HapticManager.shared.timerCompleted()
                }
            }
        }
    }
    
    func startCustomTimer(duration: Int) {
        timer?.invalidate()
        timerWorkItem?.cancel()
        
        currentTimerDuration = duration
        timeRemaining = duration
        timerActive = true
        
        timer = Timer.scheduledTimer(withTimeInterval: 1.0, repeats: true) { [weak self] timer in
            guard let self = self, self.timerActive else {
                timer.invalidate()
                return
            }
            
            Task { @MainActor in
                self.timeRemaining -= 1
                
                if self.timeRemaining <= 0 {
                    self.timerActive = false
                    self.timer?.invalidate()
                    HapticManager.shared.timerCompleted()
                }
            }
        }
    }
    
    func stopTimer() {
        timerActive = false
        timer?.invalidate()
        timerWorkItem?.cancel()
    }
    
    // MARK: - 🔧 OPTIMIZED GETTERS
    
    func getExercise(by id: UUID) -> Exercise? {
        // 🚀 Usar cache primero
        if let cachedExercise = exerciseCache[id] {
            return cachedExercise
        }
        
        // Buscar en array y cachear
        if let exercise = availableExercises.first(where: { $0.id == id }) {
            exerciseCache[id] = exercise
            return exercise
        }
        
        return nil
    }
    
    func updateBaseExercise(_ updatedBaseExercise: Exercise) {
        if let index = availableExercises.firstIndex(where: { $0.id == updatedBaseExercise.id }) {
            availableExercises[index] = updatedBaseExercise
            exerciseCache[updatedBaseExercise.id] = updatedBaseExercise
            saveData()
        }
    }
    
    func updateExerciseRestDuration(_ exerciseId: UUID, newDuration: Int) {
        if let index = availableExercises.firstIndex(where: { $0.id == exerciseId }) {
            availableExercises[index].restDuration = newDuration
            exerciseCache[exerciseId] = availableExercises[index]
            saveData()
        }
    }
    
    func toggleDay(_ day: WorkoutDay) {
        if let idx = activeDays.firstIndex(of: day) {
            activeDays.remove(at: idx)
        } else {
            activeDays.append(day)
            activeDays.sort { WorkoutDay.allCases.firstIndex(of: $0)! < WorkoutDay.allCases.firstIndex(of: $1)! }
        }
        HapticManager.shared.selectionFeedback()
        saveData()
    }
    
    func reassignExercise(exerciseId: UUID, toDays newDays: Set<WorkoutDay>) {
        guard let baseExercise = getExercise(by: exerciseId) else { return }
        
        // Remover de días existentes
        for day in WorkoutDay.allCases {
            dailyWorkoutRecords[day]?.removeAll { $0.exerciseId == exerciseId }
        }
        
        // Agregar a nuevos días
        for day in newDays {
            let newWorkoutRecord = WorkoutExercise(from: baseExercise)
            dailyWorkoutRecords[day]?.append(newWorkoutRecord)
        }
        saveData()
    }
    
    // MARK: - 🚀 CORE DATA INTEGRATION
    
    private func observeCoreDataChanges() async {
        // Observer para cambios en Core Data
        for await _ in NotificationCenter.default.notifications(named: .NSManagedObjectContextDidSave) {
            await handleCoreDataUpdate()
        }
    }
    
    @MainActor
    private func handleCoreDataUpdate() async {
        guard isCoreDataActive else { return }
        
        // Sincronizar datos con Core Data
        do {
            let workouts = try await coreDataManager.fetchWorkouts()
            // Procesar workouts...
            print("✅ Core Data sync completed")
        } catch {
            print("❌ Core Data sync failed: \(error)")
        }
    }
    
    func activateCoreData() async {
        print("🔄 Activating Core Data...")
        
        do {
            // Migrar datos existentes a Core Data
            try await migrateToCoreData()
            isCoreDataActive = true
            print("✅ Core Data activated successfully")
        } catch {
            print("❌ Failed to activate Core Data: \(error)")
        }
    }
    
    private func migrateToCoreData() async throws {
        // Migración optimizada en background
        try await coreDataManager.performBatchOperation {
            // Migrar ejercicios
            for exercise in self.availableExercises {
                let workoutDict: [String: Any] = [
                    "id": exercise.id.uuidString,
                    "name": exercise.name,
                    "category": exercise.category.rawValue,
                    "sets": exercise.sets,
                    "reps": exercise.reps,
                    "restDuration": exercise.restDuration
                ]
                
                // Esta línea necesita ser modificada para no usar await dentro del closure
                print("Migrating exercise: \(exercise.name)")
            }
            
            print("✅ Migration to Core Data completed")
            return true
        }
    }
    
    // MARK: - Body Weight & Notes
    
    func updateBodyWeight(for date: Date, weight: Double) {
        let key = Calendar.current.startOfDay(for: date)
        bodyWeightHistory[key] = weight
        HapticManager.shared.success()
        saveData()
    }
    
    func bodyWeightForDate(_ date: Date) -> Double? {
        let key = Calendar.current.startOfDay(for: date)
        return bodyWeightHistory[key]
    }
    
    func getSessionNote(for date: Date) -> String? {
        let key = Calendar.current.startOfDay(for: date)
        return sessionNotes[key]
    }
    
    func saveSessionNote(_ note: String, for date: Date) {
        let key = Calendar.current.startOfDay(for: date)
        if note.isEmpty {
            sessionNotes.removeValue(forKey: key)
        } else {
            sessionNotes[key] = note
        }
        saveData()
    }
    
    // MARK: - Data Management
    
    private func setupInitialData() {
        // Setup inicial optimizado
        for day in WorkoutDay.allCases {
            dailyWorkoutRecords[day] = []
        }
    }
    
    private func loadData() {
        // Carga optimizada desde UserDefaults
        let decoder = JSONDecoder()
        
        if let data = UserDefaults.standard.data(forKey: "AvailableExercises"),
           let exercises = try? decoder.decode([Exercise].self, from: data) {
            availableExercises = exercises
            
            // Popular cache
            for exercise in exercises {
                exerciseCache[exercise.id] = exercise
            }
        }
        
        if let data = UserDefaults.standard.data(forKey: "DailyWorkoutRecords"),
           let records = try? decoder.decode([WorkoutDay: [WorkoutExercise]].self, from: data) {
            dailyWorkoutRecords = records
        }
        
        if let data = UserDefaults.standard.data(forKey: "WorkoutHistory"),
           let history = try? decoder.decode([Date: [WorkoutDay: [WorkoutExercise]]].self, from: data) {
            workoutHistory = history
        }
        
        if let data = UserDefaults.standard.data(forKey: "BodyWeightHistory"),
           let weights = try? decoder.decode([Date: Double].self, from: data) {
            bodyWeightHistory = weights
        }
        
        if let data = UserDefaults.standard.data(forKey: "SessionNotes"),
           let notes = try? decoder.decode([Date: String].self, from: data) {
            sessionNotes = notes
        }
        
        if let data = UserDefaults.standard.data(forKey: "ActiveDays"),
           let days = try? decoder.decode([WorkoutDay].self, from: data) {
            activeDays = days
        }
        
        cleanupOldData()
    }
    
    private func recordHistory(for day: WorkoutDay) {
        let key = Calendar.current.startOfDay(for: Date())
        workoutHistory[key] = dailyWorkoutRecords
    }
    
    private func cleanupOldData() {
        let calendar = Calendar.current
        let cutoffDate = calendar.date(byAdding: .day, value: -MAX_HISTORY_DAYS, to: Date()) ?? Date()
        
        let oldHistoryKeys = workoutHistory.keys.filter { $0 < cutoffDate }
        let oldNoteKeys = sessionNotes.keys.filter { $0 < cutoffDate }
        
        for key in oldHistoryKeys {
            workoutHistory.removeValue(forKey: key)
        }
        
        for key in oldNoteKeys {
            sessionNotes.removeValue(forKey: key)
        }
        
        print("🧹 Limpiados \(oldHistoryKeys.count) registros antiguos y \(oldNoteKeys.count) notas")
    }
    
    // MARK: - Core Data Placeholders
    func migrateFromUserDefaults() {
        print("WorkoutViewModel: migrateFromUserDefaults llamado")
    }
    
    func saveToCoreData() {
        print("WorkoutViewModel: saveToCoreData llamado")
        saveData()
    }
    
    // MARK: - Stats Placeholders
    func weeklyProgress() -> Double { return 0.5 }
    func weeklyCompletedDays() -> Int { return 3 }
    
    // MARK: - Memory Management
    deinit {
        timer?.invalidate()
        saveWorkItem?.cancel()
        print("🧹 WorkoutViewModel deallocated")
    }
}
