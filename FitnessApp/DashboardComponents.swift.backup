//  DashboardComponents.swift
//  FitnessApp
//
//  Complete dashboard components for the fitness app
//

import SwiftUI

// MARK: - Dashboard Header View (renamed to avoid conflict)
struct DashboardHeaderView: View {
    @Binding var mainSelectedTab: Int
    @EnvironmentObject var themeManager: ThemeManager
    @EnvironmentObject var userManager: UserManager
    @EnvironmentObject var viewModel: WorkoutViewModel
    @State private var showingNotifications = false
    
    var body: some View {
        HStack {
            VStack(alignment: .leading, spacing: 4) {
                Text(userManager.getGreeting())
                    .font(AppFonts.title)
                    .fontWeight(.bold)
                    .foregroundColor(AppColors.textPrimary(isDark: themeManager.isDarkMode))
                
                Text("¡Es hora de entrenar!")
                    .font(AppFonts.body)
                    .foregroundColor(AppColors.textSecondary(isDark: themeManager.isDarkMode))
            }
            
            Spacer()
            
            Button(action: {
                HapticManager.shared.buttonTapped()
                showingNotifications = true
            }) {
                ZStack {
                    Circle()
                        .fill(AppColors.cardBackground(isDark: themeManager.isDarkMode))
                        .frame(width: 44, height: 44)
                    
                    Image(systemName: "bell.fill")
                        .font(.system(size: 20))
                        .foregroundColor(AppColors.primary(themeManager: themeManager))
                    
                    // Badge para notificaciones no leídas
                    if NotificationStore.shared.unreadCount > 0 {
                        Circle()
                            .fill(Color.red)
                            .frame(width: 18, height: 18)
                            .overlay(
                                Text("\(NotificationStore.shared.unreadCount)")
                                    .font(.system(size: 10, weight: .bold))
                                    .foregroundColor(.white)
                            )
                            .offset(x: 12, y: -12)
                    }
                }
            }
            .shadow(color: Color.black.opacity(0.1), radius: 10, x: 0, y: 4)
        }
        .sheet(isPresented: $showingNotifications) {
            NotificationsView()
                .environmentObject(themeManager)
        }
    }
}

// MARK: - Weekly Progress View
struct WeeklyProgressView: View {
    @EnvironmentObject var viewModel: WorkoutViewModel
    @EnvironmentObject var themeManager: ThemeManager
    
    var body: some View {
        VStack(alignment: .leading, spacing: 16) {
            HStack {
                Text("Progreso Semanal")
                    .font(AppFonts.subtitle)
                    .fontWeight(.bold)
                    .foregroundColor(AppColors.textPrimary(isDark: themeManager.isDarkMode))
                
                Spacer()
                
                Text("\(Int(viewModel.weeklyProgress() * 100))%")
                    .font(AppFonts.subtitle)
                    .fontWeight(.bold)
                    .foregroundColor(AppColors.primary(themeManager: themeManager))
            }
            
            // Barra de progreso
            ProgressView(value: viewModel.weeklyProgress())
                .progressViewStyle(LinearProgressViewStyle(tint: AppColors.primary(themeManager: themeManager)))
                .scaleEffect(x: 1, y: 2, anchor: .center)
            
            // Estadísticas rápidas
            HStack(spacing: 20) {
                WeeklyStatItem(
                    icon: "calendar.badge.checkmark",
                    value: "\(viewModel.weeklyCompletedDays())",
                    label: "Días",
                    themeManager: themeManager
                )
                
                WeeklyStatItem(
                    icon: "checkmark.circle.fill",
                    value: "\(viewModel.weeklyCompletedSets())",
                    label: "Series",
                    themeManager: themeManager
                )
                
                WeeklyStatItem(
                    icon: "clock.fill",
                    value: "\(viewModel.weeklyTotalTime() / 60)",
                    label: "Min",
                    themeManager: themeManager
                )
            }
        }
        .padding()
        .background(AppColors.cardBackground(isDark: themeManager.isDarkMode))
        .cornerRadius(20)
        .shadow(color: Color.black.opacity(themeManager.isDarkMode ? 0.3 : 0.06), radius: 8, x: 0, y: 4)
    }
}

// MARK: - Weekly Stat Item
struct WeeklyStatItem: View {
    let icon: String
    let value: String
    let label: String
    let themeManager: ThemeManager
    
    var body: some View {
        VStack(spacing: 4) {
            Image(systemName: icon)
                .font(.system(size: 16))
                .foregroundColor(AppColors.primary(themeManager: themeManager))
            
            Text(value)
                .font(.system(size: 18, weight: .bold))
                .foregroundColor(AppColors.textPrimary(isDark: themeManager.isDarkMode))
            
            Text(label)
                .font(.caption)
                .foregroundColor(AppColors.textSecondary(isDark: themeManager.isDarkMode))
        }
        .frame(maxWidth: .infinity)
    }
}

// MARK: - Stats Cards View
struct StatsCardsView: View {
    let onNavigateToBestDay: (WorkoutDay) -> Void
    let onNavigateToExercises: () -> Void
    @EnvironmentObject var viewModel: WorkoutViewModel
    @EnvironmentObject var themeManager: ThemeManager
    
    var body: some View {
        LazyVGrid(columns: [
            GridItem(.flexible()),
            GridItem(.flexible())
        ], spacing: 16) {
            
            // Días consecutivos
            StatCard(
                icon: "flame.fill",
                iconColor: .orange,
                title: "Días Consecutivos",
                value: "\(viewModel.consecutiveWorkoutDays())",
                subtitle: "¡Sigue así!",
                themeManager: themeManager
            ) {
                // Acción al tocar
            }
            
            // Mejor día
            StatCard(
                icon: "star.fill",
                iconColor: .yellow,
                title: "Mejor Día",
                value: viewModel.bestWorkoutDay()?.displayName ?? "N/A",
                subtitle: "Mayor progreso",
                themeManager: themeManager
            ) {
                if let bestDay = viewModel.bestWorkoutDay() {
                    onNavigateToBestDay(bestDay)
                }
            }
            
            // Total ejercicios
            StatCard(
                icon: "dumbbell.fill",
                iconColor: .blue,
                title: "Ejercicios",
                value: "\(viewModel.totalUniqueExercises())",
                subtitle: "En tu rutina",
                themeManager: themeManager
            ) {
                onNavigateToExercises()
            }
            
            // Tiempo total
            StatCard(
                icon: "clock.fill",
                iconColor: .green,
                title: "Tiempo Semanal",
                value: "\(viewModel.weeklyTotalTime() / 3600)h",
                subtitle: "Entrenando",
                themeManager: themeManager
            ) {
                // Acción al tocar
            }
        }
    }
}

// MARK: - Stat Card
struct StatCard: View {
    let icon: String
    let iconColor: Color
    let title: String
    let value: String
    let subtitle: String
    let themeManager: ThemeManager
    let action: () -> Void
    
    var body: some View {
        Button(action: {
            HapticManager.shared.buttonTapped()
            action()
        }) {
            VStack(alignment: .leading, spacing: 12) {
                HStack {
                    ZStack {
                        Circle()
                            .fill(iconColor.opacity(0.2))
                            .frame(width: 32, height: 32)
                        
                        Image(systemName: icon)
                            .font(.system(size: 16, weight: .medium))
                            .foregroundColor(iconColor)
                    }
                    
                    Spacer()
                }
                
                VStack(alignment: .leading, spacing: 4) {
                    Text(value)
                        .font(.system(size: 24, weight: .bold))
                        .foregroundColor(AppColors.textPrimary(isDark: themeManager.isDarkMode))
                    
                    Text(title)
                        .font(.system(size: 14, weight: .medium))
                        .foregroundColor(AppColors.textPrimary(isDark: themeManager.isDarkMode))
                    
                    Text(subtitle)
                        .font(.system(size: 12))
                        .foregroundColor(AppColors.textSecondary(isDark: themeManager.isDarkMode))
                }
                
                Spacer()
            }
            .padding(16)
            .frame(height: 120)
            .background(AppColors.cardBackground(isDark: themeManager.isDarkMode))
            .cornerRadius(20)
            .shadow(color: Color.black.opacity(themeManager.isDarkMode ? 0.3 : 0.06), radius: 10, x: 0, y: 4)
        }
        .buttonStyle(PlainButtonStyle())
    }
}

// MARK: - Dashboard Weekly Exercises List (renamed to avoid conflict)
struct DashboardWeeklyExercisesList: View {
    @EnvironmentObject var viewModel: WorkoutViewModel
    @EnvironmentObject var themeManager: ThemeManager
    
    var body: some View {
        VStack(alignment: .leading, spacing: 16) {
            Text("Resumen Semanal")
                .font(AppFonts.subtitle)
                .fontWeight(.bold)
                .foregroundColor(AppColors.textPrimary(isDark: themeManager.isDarkMode))
            
            let exercisesSummary = viewModel.weeklyExercisesSummary()
            
            if exercisesSummary.isEmpty {
                EmptyExercisesView(themeManager: themeManager)
            } else {
                ForEach(exercisesSummary.indices, id: \.self) { index in
                    let dayData = exercisesSummary[index]
                    WeeklyDayCard(
                        day: dayData.day,
                        exercises: dayData.exercises,
                        themeManager: themeManager
                    )
                }
            }
        }
        .padding()
        .background(AppColors.cardBackground(isDark: themeManager.isDarkMode))
        .cornerRadius(20)
        .shadow(color: Color.black.opacity(themeManager.isDarkMode ? 0.3 : 0.06), radius: 8, x: 0, y: 4)
    }
}

// MARK: - Empty Exercises View
struct EmptyExercisesView: View {
    let themeManager: ThemeManager
    
    var body: some View {
        VStack(spacing: 12) {
            Image(systemName: "plus.circle.dashed")
                .font(.system(size: 40))
                .foregroundColor(AppColors.textSecondary(isDark: themeManager.isDarkMode))
            
            Text("No hay ejercicios programados")
                .font(AppFonts.body)
                .foregroundColor(AppColors.textSecondary(isDark: themeManager.isDarkMode))
                .multilineTextAlignment(.center)
            
            Text("Añade ejercicios en la pestaña Ejercicios")
                .font(AppFonts.caption)
                .foregroundColor(AppColors.textSecondary(isDark: themeManager.isDarkMode))
                .multilineTextAlignment(.center)
        }
        .padding(.vertical, 20)
        .frame(maxWidth: .infinity)
    }
}

// MARK: - Weekly Day Card
struct WeeklyDayCard: View {
    let day: WorkoutDay
    let exercises: [(baseExercise: Exercise, record: WorkoutExercise)]
    let themeManager: ThemeManager
    
    var body: some View {
        VStack(alignment: .leading, spacing: 12) {
            HStack {
                Text(day.displayName)
                    .font(.system(size: 16, weight: .semibold))
                    .foregroundColor(AppColors.textPrimary(isDark: themeManager.isDarkMode))
                
                Spacer()
                
                Text("\(completedSets)/\(totalSets) series")
                    .font(.caption)
                    .foregroundColor(AppColors.textSecondary(isDark: themeManager.isDarkMode))
            }
            
            // Barra de progreso del día
            ProgressView(value: dayProgress)
                .progressViewStyle(LinearProgressViewStyle(tint: AppColors.primary(themeManager: themeManager)))
                .scaleEffect(x: 1, y: 1.5, anchor: .center)
            
            // Lista de ejercicios
            ForEach(exercises.indices, id: \.self) { index in
                let exerciseData = exercises[index]
                WeeklyExerciseRow(
                    exercise: exerciseData.baseExercise,
                    record: exerciseData.record,
                    themeManager: themeManager
                )
            }
        }
        .padding()
        .background(AppColors.background(isDark: themeManager.isDarkMode))
        .cornerRadius(20)
        .overlay(
            RoundedRectangle(cornerRadius: 12)
                .stroke(AppColors.border(isDark: themeManager.isDarkMode), lineWidth: 1)
        )
    }
    
    private var totalSets: Int {
        exercises.reduce(0) { $0 + $1.baseExercise.totalSets }
    }
    
    private var completedSets: Int {
        exercises.reduce(0) { $0 + $1.record.completedSets }
    }
    
    private var dayProgress: Double {
        guard totalSets > 0 else { return 0 }
        return Double(completedSets) / Double(totalSets)
    }
}

// MARK: - Weekly Exercise Row
struct WeeklyExerciseRow: View {
    let exercise: Exercise
    let record: WorkoutExercise
    let themeManager: ThemeManager
    
    var body: some View {
        HStack(spacing: 12) {
            // Icono del ejercicio
            ZStack {
                Circle()
                    .fill(Color.fromHexString(exercise.iconColor).opacity(0.2))
                    .frame(width: 32, height: 32)
                
                Image(systemName: exercise.sfSymbolIcon ?? "dumbbell.fill")
                    .font(.system(size: 14, weight: .medium))
                    .foregroundColor(Color.fromHexString(exercise.iconColor))
            }
            
            // Información del ejercicio
            VStack(alignment: .leading, spacing: 2) {
                Text(exercise.name)
                    .font(.system(size: 14, weight: .medium))
                    .foregroundColor(AppColors.textPrimary(isDark: themeManager.isDarkMode))
                    .lineLimit(1)
                
                HStack(spacing: 8) {
                    if exercise.repetitions > 0 {
                        Text("\(exercise.repetitions) reps")
                            .font(.caption2)
                            .foregroundColor(AppColors.textSecondary(isDark: themeManager.isDarkMode))
                    }
                    
                    if exercise.weight > 0 {
                        Text("\(String(format: "%.1f", exercise.weight))kg")
                            .font(.caption2)
                            .foregroundColor(AppColors.textSecondary(isDark: themeManager.isDarkMode))
                    }
                }
            }
            
            Spacer()
            
            // Progreso
            Text("\(record.completedSets)/\(exercise.totalSets)")
                .font(.caption)
                .fontWeight(.medium)
                .foregroundColor(
                    record.completedSets >= exercise.totalSets ?
                    AppColors.success : AppColors.textSecondary(isDark: themeManager.isDarkMode)
                )
        }
    }
}
