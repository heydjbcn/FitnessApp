    // MARK: - Clear Collection (for testing)
    
    func clearExercises() async {
        print("🗑️ Limpiando colección exercises...")
        
        do {
            let snapshot = try await db.collection("exercises").getDocuments()
            
            for document in snapshot.documents {
                try await document.reference.delete()
            }
            
            print("✅ Colección limpiada exitosamente")
        } catch {
            print("❌ Error limpiando colección: \(error)")
        }
    }
    
    // MARK: - Add Exercise
    func saveExercise(_ exercise: Exercise) async {
        print("💾 Guardando ejercicio: \(exercise.name)")
        
        do {
            let exerciseData: [String: Any] = [
                "id": exercise.id.uuidString,
                "name": exercise.name,
                "targetMuscle": exercise.targetMuscle,
                "repetitions": exercise.repetitions,
                "totalSets": exercise.totalSets,
                "weight": exercise.weight,
                "restDuration": exercise.restDuration,
                "sfSymbolIcon": exercise.sfSymbolIcon ?? "dumbbell.fill",
                "iconColor": exercise.iconColor ?? "",
                "info": exercise.info,
                "segundos": exercise.segundos,
                "rir": exercise.rir,
                "createdAt": Timestamp(date: Date()),
                "isFromFirebase": true
            ]
            
            try await db.collection("exercises").document(exercise.id.uuidString).setData(exerciseData)
            print("✅ Ejercicio guardado exitosamente: \(exercise.name)")
            
        } catch {
            print("❌ Error guardando ejercicio: \(error)")
        }
    }
}
