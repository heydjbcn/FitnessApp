import Foundation
import Firebase
import FirebaseFirestore
import Combine

@MainActor
class FirebaseExerciseService: ObservableObject {
    static let shared = FirebaseExerciseService()
    
    private let db = Firestore.firestore()
    @Published var exercises: [Exercise] = []
    @Published var isLoading = false
    @Published var error: String?
    
    private init() {
        print("🔥 FirebaseExerciseService inicializado")
    }
    
    // MARK: - Fetch Exercises from Firebase
    
    func fetchExercises() async -> [Exercise] {
        print("🔥 Iniciando fetchExercises...")
        
        isLoading = true
        error = nil
        
        do {
            print("🔥 Obteniendo documentos de Firestore...")
            let snapshot = try await db.collection("exercises").getDocuments()
            
            print("🔥 Documentos obtenidos: \(snapshot.documents.count)")
            
            var fetchedExercises: [Exercise] = []
            
            for document in snapshot.documents {
                let data = document.data()
                print("🔥 Procesando documento: \(document.documentID)")
                print("🔥 Datos: \(data)")
                
                let exercise = Exercise(from: data)
                fetchedExercises.append(exercise)
            }
            
            print("🔥 Total ejercicios procesados: \(fetchedExercises.count)")
            
            await MainActor.run {
                self.exercises = fetchedExercises
                self.isLoading = false
            }
            
            return fetchedExercises
            
        } catch {
            print("❌ Error obteniendo ejercicios de Firebase: \(error)")
            print("❌ Error detallado: \(error.localizedDescription)")
            
            await MainActor.run {
                self.error = error.localizedDescription
                self.isLoading = false
                self.exercises = []
            }
            
            return []
        }
    }
    
    // MARK: - Test Firebase Connection
    
    func testFirebaseConnection() async -> (success: Bool, message: String) {
        print("🧪 Probando conexión a Firebase...")
        
        do {
            // Intentar obtener un documento de prueba
            let snapshot = try await db.collection("exercises").limit(to: 1).getDocuments()
            
            if snapshot.documents.isEmpty {
                print("⚠️ Colección exercises está vacía")
                return (false, "Colección 'exercises' vacía")
            } else {
                print("✅ Conexión a Firebase exitosa")
                return (true, "Conexión exitosa - \(snapshot.documents.count) documentos encontrados")
            }
            
        } catch {
            print("❌ Error de conexión: \(error)")
            return (false, "Error: \(error.localizedDescription)")
        }
    }
    
