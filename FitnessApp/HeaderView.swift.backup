//
//  HeaderView.swift
//  FitnessApp
//
//  Vista de cabecera unificada para el Dashboard
//

import SwiftUI

// MARK: - Header View Principal
struct HeaderView: View {
    @EnvironmentObject var themeManager: ThemeManager
    @EnvironmentObject var userManager: UserManager
    @EnvironmentObject var viewModel: WorkoutViewModel
    @State private var showingNotifications = false
    
    var body: some View {
        HStack {
            VStack(alignment: .leading, spacing: 4) {
                Text(userManager.getGreeting())
                    .font(.title2)
                    .fontWeight(.bold)
                    .foregroundColor(AppColors.textPrimary(isDark: themeManager.isDarkMode))
                
                Text("¡Es hora de entrenar!")
                    .font(.subheadline)
                    .foregroundColor(AppColors.textSecondary(isDark: themeManager.isDarkMode))
            }
            
            Spacer()
            
            Button(action: {
                HapticManager.shared.buttonTapped()
                showingNotifications = true
            }) {
                ZStack {
                    Circle()
                        .fill(AppColors.cardBackground(isDark: themeManager.isDarkMode))
                        .frame(width: 44, height: 44)
                    
                    Image(systemName: "bell.fill")
                        .font(.system(size: 20))
                        .foregroundColor(AppColors.primary(themeManager: themeManager))
                }
            }
            .shadow(color: Color.black.opacity(themeManager.isDarkMode ? 0.3 : 0.06), radius: 10, x: 0, y: 4)
        }
        .sheet(isPresented: $showingNotifications) {
            NotificationsView()
                .environmentObject(themeManager)
        }
    }
}

// MARK: - Vista Compacta del Timer (Definición única)
struct CompactTimerView: View {
    let onStop: () -> Void
    @EnvironmentObject var viewModel: WorkoutViewModel
    @EnvironmentObject var themeManager: ThemeManager

    var body: some View {
        if viewModel.timerActive {
            HStack {
                Image(systemName: "timer")
                    .foregroundColor(AppColors.primary(themeManager: themeManager))
                
                Text("Descanso: \(formatTime(viewModel.timeRemaining))")
                    .font(.headline)
                    .foregroundColor(AppColors.textPrimary(isDark: themeManager.isDarkMode))
                
                Spacer()
                
                Button("Parar") {
                    HapticManager.shared.buttonTapped()
                    onStop()
                }
                .buttonStyle(.bordered)
                .tint(AppColors.primary(themeManager: themeManager))
            }
            .padding()
            .background(AppColors.cardBackground(isDark: themeManager.isDarkMode))
            .cornerRadius(20)
            .shadow(color: Color.black.opacity(themeManager.isDarkMode ? 0.3 : 0.06), radius: 10, x: 0, y: 4)
            .transition(.move(edge: .bottom).combined(with: .opacity))
        }
    }
    
    private func formatTime(_ seconds: Int) -> String {
        let minutes = seconds / 60
        let remainingSeconds = seconds % 60
        return String(format: "%d:%02d", minutes, remainingSeconds)
    }
}
