//
//  DebugExercises.swift
//  FitnessApp
//
//  Script de debug para ejercicios
//

import Foundation
import CoreData

extension WorkoutViewModel {
    
    func debugExercises() {
        print("🔍 === DEBUG EJERCICIOS ===")
        print("📊 currentExercises.count: \(currentExercises.count)")
        print("📊 availableExercises.count: \(availableExercises.count)")
        print("🔥 firebaseExercises.count: \(firebaseExercises.count)")
        
        if currentExercises.isEmpty {
            print("⚠️ currentExercises está vacío - esto es normal al inicio")
            print("� Los ejercicios vendrán de Firebase o serán creados por el usuario")
        } else {
            print("✅ currentExercises contiene \(currentExercises.count) ejercicios del usuario:")
            for (i, exercise) in currentExercises.enumerated() {
                print("   \(i + 1). \(exercise.name)")
            }
        }
        
        if !firebaseExercises.isEmpty {
            print("🔥 Firebase tiene \(firebaseExercises.count) ejercicios:")
            for (i, exercise) in firebaseExercises.prefix(5).enumerated() {
                print("   \(i + 1). \(exercise.name) - \(exercise.targetMuscle)")
            }
        } else {
            print("⚠️ No hay ejercicios de Firebase cargados")
        }
        
        // Debug de Core Data
        Task {
            let context = coreDataManager.persistentContainer.viewContext
            let request: NSFetchRequest<ExerciseEntity> = ExerciseEntity.fetchRequest()
            
            do {
                let exerciseEntities = try context.fetch(request)
                await MainActor.run {
                    print("📊 Core Data contiene \(exerciseEntities.count) ExerciseEntity:")
                    for (i, entity) in exerciseEntities.enumerated() {
                        print("   \(i + 1). \(entity.name ?? "Sin nombre")")
                    }
                }
            } catch {
                print("❌ Error fetching ExerciseEntity: \(error)")
            }
        }
    }
    
    func forceLoadDefaultExercises() {
        print("🚀 FORZANDO CARGA DE EJERCICIOS POR DEFECTO")
        
        Task {
            // Limpiar Core Data primero
            let context = coreDataManager.persistentContainer.viewContext
            let request: NSFetchRequest<ExerciseEntity> = ExerciseEntity.fetchRequest()
            
            do {
                let existingEntities = try context.fetch(request)
                for entity in existingEntities {
                    context.delete(entity)
                }
                await coreDataManager.saveContext()
                print("🧹 Core Data limpiado")
            } catch {
                print("❌ Error limpiando Core Data: \(error)")
            }
            
            // Crear ejercicios por defecto
            await createDefaultExercises()
            
            // Verificar resultado
            await MainActor.run {
                print("✅ Después de forzar carga:")
                print("📊 currentExercises.count: \(self.currentExercises.count)")
                self.debugExercises()
            }
        }
    }
}
