import Foundation
import CoreData
import Combine

/// Manager para la migración de datos de UserDefaults a Core Data
@MainActor
class DataMigrationManager: ObservableObject {
    static let shared = DataMigrationManager()
    
    @Published var isPerformingMigration = false
    @Published var migrationProgress: Double = 0.0
    @Published var currentMigrationStage: MigrationStage = .notStarted
    @Published var migrationError: Error?
    @Published var hasMigrationCompleted = false
    
    private let migrationKey = "HasCompletedCoreDataMigration_v1"
    private let userDefaults = UserDefaults.standard
    
    enum MigrationStage: String, CaseIterable {
        case notStarted = "Preparando migración..."
        case preparingData = "Preparando datos..."
        case migratingExercises = "Migrando ejercicios..."
        case migratingSessions = "Migrando sesiones..."
        case cleaningUp = "Limpiando datos temporales..."
        case completed = "Migración completada"
        case failed = "Error en la migración"
    }
    
    private init() {
        loadMigrationStatus()
    }
    
    private func loadMigrationStatus() {
        hasMigrationCompleted = userDefaults.bool(forKey: migrationKey)
        print("DataMigrationManager: Estado de migración cargado - Completada: \(hasMigrationCompleted)")
    }
    
    func needsMigration() -> Bool {
        // Verificar si ya se completó la migración
        if hasMigrationCompleted {
            return false
        }
        
        // Verificar si hay datos en UserDefaults que necesiten migración
        let hasUserDefaultsData = userDefaults.data(forKey: "AvailableExercises") != nil ||
                                 userDefaults.data(forKey: "DailyWorkoutRecords") != nil ||
                                 userDefaults.data(forKey: "WorkoutHistory") != nil
        
        return hasUserDefaultsData
    }
    
    func performMigration(context: NSManagedObjectContext) async {
        guard !isPerformingMigration else {
            print("⚠️ Migración ya en progreso")
            return
        }
        
        isPerformingMigration = true
        migrationProgress = 0.0
        migrationError = nil
        currentMigrationStage = .preparingData
        
        do {
            // Etapa 1: Preparar datos (20%)
            await updateProgress(0.2, stage: .preparingData)
            let legacyData = try loadLegacyData()
            
            // Etapa 2: Migrar ejercicios (40%)
            await updateProgress(0.4, stage: .migratingExercises)
            try await migrateExercises(legacyData.exercises, context: context)
            
            // Etapa 3: Migrar sesiones (70%)
            await updateProgress(0.7, stage: .migratingSessions)
            try await migrateSessions(legacyData.sessions, context: context)
            
            // Etapa 4: Limpiar (90%)
            await updateProgress(0.9, stage: .cleaningUp)
            try await cleanupLegacyData()
            
            // Etapa 5: Completar (100%)
            await updateProgress(1.0, stage: .completed)
            completeMigration()
            
            print("✅ Migración completada exitosamente")
            
        } catch {
            migrationError = error
            currentMigrationStage = .failed
            print("❌ Error durante la migración: \(error)")
        }
        
        isPerformingMigration = false
    }
    
    private func updateProgress(_ progress: Double, stage: MigrationStage) async {
        await MainActor.run {
            self.migrationProgress = progress
            self.currentMigrationStage = stage
        }
        
        // Pequeña pausa para permitir que la UI se actualice
        try? await Task.sleep(nanoseconds: 500_000_000) // 0.5 segundos
    }
    
    private func loadLegacyData() throws -> LegacyData {
        let decoder = JSONDecoder()
        var exercises: [Exercise] = []
        var sessions: [LegacySession] = []
        
        // Cargar ejercicios
        if let data = userDefaults.data(forKey: "AvailableExercises") {
            exercises = try decoder.decode([Exercise].self, from: data)
        }
        
        // Cargar historial de entrenamientos y convertir a sesiones
        if let data = userDefaults.data(forKey: "WorkoutHistory") {
            let history = try decoder.decode([Date: [WorkoutDay: [WorkoutExercise]]].self, from: data)
            sessions = convertHistoryToSessions(history)
        }
        
        return LegacyData(exercises: exercises, sessions: sessions)
    }
    
    private func convertHistoryToSessions(_ history: [Date: [WorkoutDay: [WorkoutExercise]]]) -> [LegacySession] {
        var sessions: [LegacySession] = []
        
        for (date, dayHistory) in history {
            for (workoutDay, exercises) in dayHistory {
                let session = LegacySession(
                    date: date,
                    workoutDay: workoutDay,
                    exercises: exercises
                )
                sessions.append(session)
            }
        }
        
        return sessions
    }
    
    /// Método público para migrar ejercicios específicos
    func migrateExercises(_ exercises: [Exercise]) async throws {
        let context = CoreDataManager.shared.context
        try await migrateExercises(exercises, context: context)
        Task { await CoreDataManager.shared.saveContext() }
    }
    
    private func migrateExercises(_ exercises: [Exercise], context: NSManagedObjectContext) async throws {
        for exercise in exercises {
            let entity = ExerciseEntity(context: context)
            entity.id = exercise.id
            entity.name = exercise.name
            entity.targetMuscle = exercise.targetMuscle
            entity.exerciseDescription = exercise.description
            entity.instructions = exercise.instructions
            entity.defaultWeight = exercise.defaultWeight
            entity.defaultReps = Int32(exercise.defaultReps)
            entity.defaultSets = Int32(exercise.defaultSets)
            entity.isBodyWeight = exercise.isBodyWeight
            entity.category = exercise.category.rawValue
            entity.maxWeight = exercise.personalRecord?.maxWeight ?? 0
            entity.maxReps = Int32(exercise.personalRecord?.maxReps ?? 0)
            entity.recordDate = exercise.personalRecord?.dateAchieved ?? Date()
            entity.createdAt = Date()
            entity.updatedAt = Date()
            entity.iconColor = exercise.iconColor
            entity.sfSymbolIcon = exercise.sfSymbolIcon
        }
        
        try context.save()
        print("✅ Migrados \(exercises.count) ejercicios")
    }
    
    private func migrateSessions(_ sessions: [LegacySession], context: NSManagedObjectContext) async throws {
        for session in sessions {
            let workoutSession = WorkoutSession(context: context)
            workoutSession.id = UUID()
            workoutSession.date = session.date
            workoutSession.workoutDay = session.workoutDay.rawValue
            workoutSession.createdAt = session.date
            workoutSession.isCompleted = true
            workoutSession.completedAt = session.date
            
            // Migrar ejercicios completados
            for exercise in session.exercises {
                // Crear una CompletedExercise por cada serie completada
                for setNumber in 1...exercise.completedSets {
                    let completedExercise = CompletedExercise(context: context)
                    completedExercise.id = UUID()
                    completedExercise.isCompleted = true
                    completedExercise.completedAt = exercise.lastSetCompletedAt
                    completedExercise.workoutSession = workoutSession
                    completedExercise.setNumber = Int32(setNumber)
                    
                    // Buscar el ejercicio correspondiente
                    let exerciseRequest: NSFetchRequest<ExerciseEntity> = ExerciseEntity.fetchRequest()
                    exerciseRequest.predicate = NSPredicate(format: "id == %@", exercise.exerciseId as CVarArg)
                    
                    if let exerciseEntity = try context.fetch(exerciseRequest).first {
                        completedExercise.exercise = exerciseEntity
                        completedExercise.weight = exerciseEntity.defaultWeight
                        completedExercise.reps = exerciseEntity.defaultReps
                    }
                }
            }
        }
        
        try context.save()
        print("✅ Migradas \(sessions.count) sesiones")
    }
    
    private func cleanupLegacyData() async throws {
        // Mantener una copia de seguridad por si acaso
        let backupKeys = [
            "AvailableExercises_backup",
            "DailyWorkoutRecords_backup",
            "WorkoutHistory_backup",
            "BodyWeightHistory_backup",
            "SessionNotes_backup"
        ]
        
        let originalKeys = [
            "AvailableExercises",
            "DailyWorkoutRecords",
            "WorkoutHistory",
            "BodyWeightHistory",
            "SessionNotes"
        ]
        
        // Crear backups
        for (index, originalKey) in originalKeys.enumerated() {
            if let data = userDefaults.data(forKey: originalKey) {
                userDefaults.set(data, forKey: backupKeys[index])
            }
        }
        
        // Limpiar datos originales después de migración exitosa
        for key in originalKeys {
            userDefaults.removeObject(forKey: key)
        }
        
        print("✅ Datos legacy limpiados y respaldados")
    }
    
    func completeMigration() {
        userDefaults.set(true, forKey: migrationKey)
        hasMigrationCompleted = true
        isPerformingMigration = false
        currentMigrationStage = .completed
        print("✅ Migración marcada como completada")
    }
    
    func resetMigration() {
        userDefaults.set(false, forKey: migrationKey)
        hasMigrationCompleted = false
        isPerformingMigration = false
        currentMigrationStage = .notStarted
        migrationProgress = 0.0
        migrationError = nil
        print("🔄 Estado de migración reseteado")
    }
}

// MARK: - Supporting Types
private struct LegacyData {
    let exercises: [Exercise]
    let sessions: [LegacySession]
}

private struct LegacySession {
    let date: Date
    let workoutDay: WorkoutDay
    let exercises: [WorkoutExercise]
}
