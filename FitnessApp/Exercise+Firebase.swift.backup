//
//  Exercise+Firebase.swift
//  FitnessApp
//
//  Extensión para compatibilidad con Firebase
//

import Foundation
import CoreData

extension Exercise {
    
    /// Busca o crea una ExerciseEntity en Core Data
    func getExerciseEntity(in context: NSManagedObjectContext) -> ExerciseEntity {
        // Buscar si ya existe un ejercicio con el mismo nombre
        let request: NSFetchRequest<ExerciseEntity> = ExerciseEntity.fetchRequest()
        request.predicate = NSPredicate(format: "name == %@", name)
        request.fetchLimit = 1
        
        if let existingEntity = try? context.fetch(request).first {
            // Actualizar ejercicio existente con datos de Firebase
            updateExerciseEntity(existingEntity)
            return existingEntity
        } else {
            // Crear nuevo ejercicio
            let newEntity = ExerciseEntity(context: context)
            updateExerciseEntity(newEntity)
            return newEntity
        }
    }
    
    /// Actualiza una ExerciseEntity con los datos del Exercise
    private func updateExerciseEntity(_ entity: ExerciseEntity) {
        entity.id = id
        entity.name = name
        entity.targetMuscle = targetMuscle
        entity.exerciseDescription = description
        entity.instructions = instructions
        entity.defaultWeight = weight  // ✅ CORREGIDO: usar 'weight' en lugar de 'defaultWeight'
        entity.defaultReps = Int32(repetitions)  // ✅ CORREGIDO: usar 'repetitions'
        entity.defaultSets = Int32(totalSets)  // ✅ CORREGIDO: usar 'totalSets'
        entity.isBodyWeight = isBodyWeight
        entity.category = category.rawValue
        entity.restDuration = Int32(restDuration)
        entity.sfSymbolIcon = sfSymbolIcon
        entity.iconColor = iconColor
        entity.segundos = Int32(segundos)
        entity.rir = Int32(rir)
        entity.createdAt = Date()
        entity.updatedAt = Date()
    }
    
    /// Indica si el ejercicio proviene de Firebase
    var isFromFirebase: Bool {
        // Los ejercicios de Firebase tienen características específicas
        return !targetMuscle.isEmpty && !description.isEmpty
    }
    
    /// Crea una copia editable del ejercicio (para personalización del usuario)
    func createEditableCopy() -> Exercise {
        var copy = self
        copy.id = UUID() // Nuevo ID para la copia
        return copy
    }
    
    /// Determina si es un ejercicio por defecto vs. uno de Firebase
    var isDefaultExercise: Bool {
        // ✅ CORREGIDO: Ya no hay ejercicios por defecto
        // Solo ejercicios de Firebase o creados por el usuario
        return false
    }
}

// MARK: - ExerciseEntity Extensions for Firebase

extension ExerciseEntity {
    
    /// Convierte ExerciseEntity a Exercise model
    func toExercise() -> Exercise {
        var exercise = Exercise(
            id: id ?? UUID(),
            name: name ?? "Sin nombre",
            repetitions: Int(defaultReps),
            weight: defaultWeight,
            totalSets: Int(defaultSets),
            info: exerciseDescription ?? "",
            imageData: nil,
            restDuration: Int(restDuration),
            sfSymbolIcon: sfSymbolIcon,
            iconColor: iconColor ?? "blue",
            segundos: Int(segundos),
            rir: Int(rir)
        )
        
        // Propiedades adicionales
        exercise.targetMuscle = targetMuscle ?? ""
        exercise.instructions = instructions ?? ""
        exercise.isBodyWeight = isBodyWeight
        
        if let categoryRaw = category,
           let exerciseCategory = ExerciseCategory(rawValue: categoryRaw) {
            exercise.category = exerciseCategory
        }
        
        return exercise
    }
}
