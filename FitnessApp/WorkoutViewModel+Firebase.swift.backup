//
//  WorkoutViewModel+Firebase.swift - VERSIÓN CORREGIDA
//  FitnessApp
//
//  Extensión del WorkoutViewModel para integración con Firebase
//

import Foundation
import Combine
import CoreData

extension WorkoutViewModel {
    
    // MARK: - Firebase Integration
    
    /// Carga ejercicios desde Firebase
    
    /// Actualiza los ejercicios diarios basándose en currentExercises
    private func updateDailyExercises() {
        // Distribuir ejercicios entre los días de la semana
        let days = WorkoutDay.allCases
        let exercisesPerDay = max(1, currentExercises.count / days.count)
        
        for (index, day) in days.enumerated() {
            let startIndex = index * exercisesPerDay
            let endIndex = min(startIndex + exercisesPerDay, currentExercises.count)
            
            if startIndex < currentExercises.count {
                let dayExercises = Array(currentExercises[startIndex..<endIndex])
                dailyWorkoutRecords[day] = dayExercises.map { exercise in
                    WorkoutExercise(
                        exerciseId: exercise.id,
                        exerciseName: exercise.name,
                        repetitions: exercise.repetitions,
                        weight: exercise.weight,
                        totalSets: exercise.totalSets,
                        info: exercise.info,
                        imageData: exercise.imageData,
                        restDuration: exercise.restDuration,
                        sfSymbolIcon: exercise.sfSymbolIcon,
                        iconColor: exercise.iconColor,
                        segundos: exercise.segundos,
                        rir: exercise.rir
                    )
                }
            }
        }
    }
    
    /// Activa Core Data con Firebase
    func activateCoreDataWithFirebase() async {
        print("🔄 Activating Core Data with Firebase integration...")
        
        // Esperar a que Core Data esté listo
        await CoreDataManager.shared.waitForReady()
        
        // Cargar ejercicios existentes de Core Data
        await loadExercisesFromCoreData()
        
        print("✅ Core Data activated with Firebase support")
    }
    
    /// Carga ejercicios desde Core Data
    private func loadExercisesFromCoreData() async {
        do {
            let context = CoreDataManager.shared.context
            let request: NSFetchRequest<ExerciseEntity> = ExerciseEntity.fetchRequest()
            let exerciseEntities = try context.fetch(request)
            
            let exercises = exerciseEntities.map { $0.toExercise() }
            
            await MainActor.run {
                self.currentExercises = exercises
                // ✅ CORREGIDO: Ya no hay ejercicios por defecto
                // Los ejercicios vendrán de Firebase o serán creados por el usuario
                self.updateDailyExercises()
            }
            
            print("✅ Loaded \(exercises.count) exercises from Core Data")
            
        } catch {
            print("❌ Error loading exercises from Core Data: \(error)")
            await MainActor.run {
                // ✅ CORREGIDO: Ya no cargar ejercicios por defecto
                self.currentExercises = []
                self.updateDailyExercises()
            }
        }
    }
}
